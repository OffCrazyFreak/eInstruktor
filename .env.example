# Better Auth
BETTER_AUTH_URL=http://localhost:3000
# Generiraj: pnpm dlx @better-auth/cli secret
BETTER_AUTH_SECRET=

# Google OAuth (samo Google prijava)
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Turso (libSQL) - prazno = lokalni file:local.db
# https://turso.tech  ->  turso db create / turso db show --url / turso db tokens create
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
